# Backend only. Never prefix these values with VITE_ or commit your .env.
PORT=3001
HOST=127.0.0.1
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Copy the version shown in Meta's API Setup request, e.g. v24.0.
WHATSAPP_GRAPH_VERSION=
# Your own verified test recipient, country code and digits only.
WHATSAPP_TEST_RECIPIENT=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_DEMO_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://simondce.github.io
